generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  name              String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Profile {
  id               String   @id @default(cuid())
  fullName         String   @default("ABDELLAH AIT-SI")
  brandName        String   @default("CodeVirtox")
  professionalTitle String @default("Full Stack Developer | AI & Automation")
  shortBio         String   @default("Building modern web applications and smart automated solutions.")
  aboutText        String   @default("")
  footerBio        String   @default("")
  email            String   @default("contact@codevirtox.com")
  phone            String   @default("+212 600-000-000")
  location         String   @default("Oulad Teima, Morocco")
  githubUrl        String   @default("")
  linkedinUrl      String   @default("")
  instagramUrl    String   @default("")
  twitterUrl       String   @default("")
  featuredProjectsTitle      String   @default("Featured Projects")
  featuredProjectsDescription String @default("A selection of projects showcasing my experience in full-stack development, web applications, automation, and problem-solving.")
  aboutCard1Title    String @default("Build & Develop")
  aboutCard1Description String @default("Creating modern, responsive, and scalable web applications using technologies such as React, Laravel, Next.js, and MySQL.")
  aboutCard2Title    String @default("AI & Automation")
  aboutCard2Description String @default("Building intelligent workflows and automation solutions that simplify repetitive tasks and improve productivity.")
  aboutCard3Title    String @default("Learn & Improve")
  aboutCard3Description String @default("Continuously exploring new technologies, improving my skills, and building better digital products.")
  stat1Value        String   @default("6+")
  stat1Label        String   @default("Certificates")
  stat2Value        String   @default("14+")
  stat2Label        String   @default("Projects")
  stat3Value        String   @default("8+")
  stat3Label        String   @default("Technologies")
  projectsPageTitle       String @default("Selected Projects")
  projectsPageDescription String @default("A selection of projects showcasing my experience in full-stack development, web applications, automation, and problem-solving.")
  certificatesPageTitle       String @default("Certificates & Credentials")
  certificatesPageDescription String @default("A collection of certifications and professional training completed throughout my journey in software development, programming, databases, and web technologies.")
  educationPageTitle       String @default("My Educational Journey")
  educationPageDescription String @default("My academic background and continuous journey in software development and technology.")
  resumeIntro     String @default("Full-stack developer with hands-on experience building web applications, backend systems, and database-driven solutions. Focused on clean architecture, practical problem-solving, and continuous learning.")
  resumeTechTitle String @default("Technologies I work with")
  resumeExpTitle  String @default("Experience & Projects")
  contactPageTitle       String @default("Let's Build Something Great Together.")
  contactPageDescription String @default("Have a project, a role,or just want to connect? I usually reply within 24 hours.")
  footerCopyright String @default("")
  footerCredit    String @default("")
  logoUrl           String   @default("")
  profileImage     String   @default("")
  cvFile           String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Project {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  shortDescription String
  fullDescription String   @default("")
  technologies    String   @default("[]")
  startDate       String
  endDate         String   @default("")
  location        String   @default("Oulad Teima, Morocco")
  projectImage    String   @default("")
  githubUrl       String   @default("")
  liveDemoUrl     String   @default("")
  featured        Boolean  @default(false)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Certificate {
  id              String   @id @default(cuid())
  title           String
  issuer          String
  issueDate       String
  skills          String   @default("[]")
  certificateImage String   @default("")
  credentialUrl   String   @default("")
  credentialId    String   @default("")
  category        String   @default("")
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Skill {
  id           String @id @default(cuid())
  name         String
  category     String
  icon         String @default("")
  displayOrder Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Education {
  id           String @id @default(cuid())
  degree       String
  field        String
  institution  String
  location     String @default("")
  year         String
  displayOrder Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Experience {
  id           String   @id @default(cuid())
  title        String
  description  String
  technologies String   @default("[]")
  startDate    String
  endDate      String   @default("")
  location     String   @default("Oulad Teima, Morocco")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Language {
  id           String @id @default(cuid())
  name         String
  level        String
  displayOrder Int     @default(0)
}

model SoftSkill {
  id           String @id @default(cuid())
  name         String
  icon         String @default("")
  displayOrder Int     @default(0)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AppSettings {
  id                       String   @id @default("singleton")
  smtpHost                 String   @default("")
  smtpPort                 Int      @default(587)
  smtpUser                 String   @default("")
  smtpPass                 String   @default("")
  smtpSecure               Boolean  @default(true)
  fromName                 String   @default("")
  fromEmail                String   @default("")
  replyToEmail             String   @default("")
  contactReceiverEmail     String   @default("")
  contactEmailEnabled      Boolean  @default(false)
  adminLoginEmailEnabled   Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

